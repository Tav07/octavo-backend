# Copia este archivo como .env y llena los valores reales.
# Nunca subas el .env a git: el .gitignore ya lo excluye.

# PostgreSQL (Neon) — cadena de conexión con los datos reales
DATABASE_URL=postgresql://usuario:contrasena@host.neon.tech/octavo?sslmode=require

# Firma del JWT — genera uno largo y aleatorio, no uses este valor
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

# Vencimiento del token
JWT_EXPIRES_IN=1d

# Puerto donde escucha el servidor (Render lo define por ti)
PORT=3000

# URL del frontend habilitada en CORS (la de Vercel en producción)
FRONTEND_URL=http://localhost:3001