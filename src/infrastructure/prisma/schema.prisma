// Modelo de datos de la tienda Octavo. Mismas entidades de la Entrega 1:
// marcas y zapatos; usuarios y reservas para la autenticación y el alquiler.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// admin | user. Un user no ve el CRUD ni las reservas de otros.
enum Role {
  admin
  user
}

model User {
  id        Int      @id @default(autoincrement())
  nombre    String
  email     String   @unique
  password  String // solo el hash de bcrypt, nunca la contraseña en texto plano
  role      Role     @default(user)
  createdAt DateTime @default(now())

  reservas Reserva[]
}

model Marca {
  id          Int    @id @default(autoincrement())
  nombre      String @unique
  descripcion String
  pais        String

  zapatos Zapato[]
}

model Zapato {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique
  categoria   String // running | casual | formal
  precio      Decimal @db.Decimal(12, 2)
  talla       Int
  descripcion String
  imagen      String // ruta pública del frontend, ej.: /images/nike-revolution-8.jpg
  marcaId     Int
  marca       Marca   @relation(fields: [marcaId], references: [id])

  reservas Reserva[]
}

model Reserva {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  zapatoId  Int
  zapato    Zapato   @relation(fields: [zapatoId], references: [id])
  telefono  String
  talla     Int
  mensaje   String?
  createdAt DateTime @default(now())
}